{
  "manifest_version": 3,
  "name": "CAF Assistente Inteligente",
  "version": "5.0",
  "description": "Assistente flutuante de automação para preenchimento de formulários no portal do CAF (MDA).",
  "author": "João Vitor Toledo",
  "browser_specific_settings": {
    "gecko": {
      "id": "caf-assistente@incaper.es.gov.br",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg",
    "default_title": "CAF Assistente"
  },
  "host_permissions": [
    "https://caf.mda.gov.br/*",
    "https://caf-treinamento.mda.gov.br/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://caf.mda.gov.br/*",
        "https://caf-treinamento.mda.gov.br/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_end"
    }
  ]
}